{
  "description": "Column templates for every CSV output of Hayabusa (https://github.com/Yamato-Security/hayabusa): each dfir-timeline profile and the search, logon-summary, metrics and extract-base64 outputs. Matching works as for juntei-templates.json. timestampColumns are the timestamp columns, exactly; levelColorColumn colors each row by its rule level with levelColors (background and text, the same in every color scheme).",
  "hayabusaVersion": "4.3.1",
  "levelColors": {
    "source": "Hayabusa's level colors (config/level_color.txt) as row backgrounds, the same in every color scheme; informational is white",
    "levels": [
      {
        "level": "emergency",
        "values": [
          "emer",
          "emergency"
        ],
        "background": "#ff0000",
        "text": "#000000"
      },
      {
        "level": "critical",
        "values": [
          "crit",
          "critical"
        ],
        "background": "#ff0000",
        "text": "#000000"
      },
      {
        "level": "high",
        "values": [
          "high"
        ],
        "background": "#ffc100",
        "text": "#000000"
      },
      {
        "level": "medium",
        "values": [
          "med",
          "medium"
        ],
        "background": "#ffff00",
        "text": "#000000"
      },
      {
        "level": "low",
        "values": [
          "low"
        ],
        "background": "#00ff00",
        "text": "#000000"
      },
      {
        "level": "informational",
        "values": [
          "info",
          "informational"
        ],
        "background": "#ffffff",
        "text": "#000000"
      }
    ]
  },
  "templates": [
    {
      "name": "Hayabusa minimal",
      "producedBy": [
        "dfir-timeline -p minimal"
      ],
      "columns": [
        "Timestamp",
        "RuleTitle",
        "Level",
        "Computer",
        "Channel",
        "EventID",
        "RecordID",
        "Details"
      ],
      "optionalColumns": [
        "SrcASN",
        "SrcCountry",
        "SrcCity",
        "TgtASN",
        "TgtCountry",
        "TgtCity"
      ],
      "timestampColumns": [
        "Timestamp"
      ],
      "levelColorColumn": "Level"
    },
    {
      "name": "Hayabusa standard",
      "producedBy": [
        "dfir-timeline -p standard (the default profile)"
      ],
      "columns": [
        "Timestamp",
        "RuleTitle",
        "Level",
        "Computer",
        "Channel",
        "EventID",
        "RecordID",
        "Details",
        "ExtraFieldInfo",
        "RuleID"
      ],
      "optionalColumns": [
        "SrcASN",
        "SrcCountry",
        "SrcCity",
        "TgtASN",
        "TgtCountry",
        "TgtCity"
      ],
      "timestampColumns": [
        "Timestamp"
      ],
      "levelColorColumn": "Level"
    },
