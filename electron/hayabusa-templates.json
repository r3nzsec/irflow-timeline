      ]
    },
    {
      "name": "Hayabusa logon-summary (successful)",
      "producedBy": [
        "logon-summary -o <prefix>: <prefix>-successful.csv"
      ],
      "columns": [
        "Successful",
        "First Logon",
        "Last Logon",
        "Event",
        "Target Account",
        "Target Domain",
        "Target Computer",
        "Logon Type",
        "Source Account",
        "Source Domain",
        "Source Computer",
        "Source IP Address"
      ],
      "optionalColumns": [
        "Source ASN",
        "Source Country",
        "Source City"
      ],
      "timestampColumns": [
        "First Logon",
        "Last Logon"
      ]
    },
    {
      "name": "Hayabusa logon-summary (failed)",
      "producedBy": [
        "logon-summary -o <prefix>: <prefix>-failed.csv"
      ],
      "columns": [
        "Failed",
        "First Attempt",
        "Last Attempt",
        "Event",
        "Target Account",
        "Target Domain",
        "Target Computer",
        "Logon Type",
        "Source Account",
        "Source Domain",
        "Source Computer",
        "Source IP Address"
      ],
      "optionalColumns": [
        "Source ASN",
        "Source Country",
        "Source City"
      ],
      "timestampColumns": [
        "First Attempt",
        "Last Attempt"
      ]
    },
    {
      "name": "Hayabusa eid-metrics",
      "producedBy": [
        "eid-metrics -o"
      ],
      "columns": [
        "Total",
        "%",
        "Channel",
        "ID",
        "Event"
      ],
      "timestampColumns": []
    },
    {
      "name": "Hayabusa computer-metrics",
      "producedBy": [
        "computer-metrics -o"
      ],
      "columns": [
        "Computer",
        "OS information",
        "UpTime",
        "Timezone",
        "Events"
      ],
      "timestampColumns": []
    },
    {
      "name": "Hayabusa log-metrics",
      "producedBy": [
        "log-metrics -o"
      ],
      "columns": [
        "Filename",
        "Computers",
        "Events",
        "First Timestamp",
        "Last Timestamp",
        "Channels",
        "Providers",
        "Size"
      ],
      "timestampColumns": [
        "First Timestamp",
        "Last Timestamp"
      ]
    },
    {
      "name": "Hayabusa extract-base64",
      "producedBy": [
        "extract-base64 -o"
      ],
      "columns": [
        "Timestamp",
        "Computer",
        "Base64 String",
        "Decoded String",
        "Original Field",
        "Length",
        "Binary",
        "Double Encoding",
        "Encoding",
        "File Type",
        "Event",
        "Record ID",
        "File Name"
      ],
      "timestampColumns": [
        "Timestamp"
      ]
    }
