{
  "description": "Column templates for every CSV output of Juntei (https://github.com/Yamato-Security/juntei). A CSV whose header row holds every column of a template, and no column outside columns + optionalColumns unless allowExtraColumns, is that output. timestampColumns are its timestamp columns, exactly; every other column is never treated as a timestamp.",
  "junteiVersion": "1.0.0",
  "templates": [
    {
      "name": "Juntei MFT",
      "producedBy": [
        "auto-parse: FileSystem/MFT.csv",
        "parse-ntfs mft"
      ],
      "columns": [
        "EntryNum",
        "SN",
        "InUse",
        "ParentEntryNum",
        "ParentSN",
        "ParentPath",
        "File",
        "Ext",
        "Size",
        "RefCnt",
        "ReparseTarget",
        "Dir",
        "HasADS",
        "IsADS",
        "SI<FN",
        "uSecZeros",
        "Copied",
        "SI-Flags",
        "Type",
        "DataModified (SI)",
        "DataModified (FN)",
        "Accessed (SI)",
        "Accessed (FN)",
        "MetadataChanged (SI)",
        "MetadataChanged (FN)",
        "Created (SI)",
        "Created (FN)",
        "USN",
        "LogfileSN",
        "SID",
        "ObjectID-FileDroid",
        "LoggedUtilStream",
        "ZoneID-Contents",
        "SourceFile",
        "ParseErrors"
      ],
      "optionalColumns": [
        "ResidentDataBase64",
        "ResidentDataHex",
        "ResidentDataASCII",
        "FromSlack",
        "SlackRecord",
        "SlackOffset",
        "CopyOfEntryInUse"
      ],
      "timestampColumns": [
        "DataModified (SI)",
        "DataModified (FN)",
        "Accessed (SI)",
        "Accessed (FN)",
        "MetadataChanged (SI)",
        "MetadataChanged (FN)",
        "Created (SI)",
        "Created (FN)"
      ]
    },
